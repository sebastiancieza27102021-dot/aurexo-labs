# =========================================================
# Aurexo Labs — Variables de entorno
# Copia este archivo a .env.local y llena las que vayas a usar.
# .env.local está en .gitignore: NUNCA subas claves al repo.
# =========================================================

# ---- Resend — envía los leads del formulario por correo ----
# Consigue la API key en https://resend.com/api-keys
RESEND_API_KEY=

# Bandeja que recibe los leads.
LEADS_TO=contacto@aurexolabs.com

# Remitente. Dos opciones:
#  a) Sin dominio verificado: "Aurexo Labs <onboarding@resend.dev>"
#     (Resend sólo permite enviar al correo dueño de la cuenta).
#  b) Con aurexolabs.com verificado en Resend: "Aurexo Labs <leads@aurexolabs.com>"
#     (recomendado — permite enviar a cualquier bandeja y no cae en spam).
LEADS_FROM=Aurexo Labs <onboarding@resend.dev>
