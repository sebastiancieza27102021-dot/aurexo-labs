# =========================================================
# Aurexo Labs — Variables de entorno
# Copia este archivo a .env.local y llena las que vayas a usar.
# =========================================================

# ---- Resend (opción más rápida — email a tu bandeja) ----
RESEND_API_KEY=
SALES_INBOX=contacto@aurexolabs.com

# ---- Formspree (sin backend) ----
FORMSPREE_ENDPOINT=

# ---- Supabase (almacenamiento de leads) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sheets (Apps Script webhook) ----
GOOGLE_SHEETS_WEBHOOK_URL=
